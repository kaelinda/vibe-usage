{
  "name": "vibe-usage",
  "version": "1.0.0",
  "description": "AI Token Usage Monitor - Real-time monitoring of AI API token usage across platforms",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "bash dev.sh",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "make": "electron-forge make",
    "make:mac": "electron-forge make --platform=darwin",
    "make:win": "electron-forge make --platform=win32",
    "make:linux": "electron-forge make --platform=linux",
    "test": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .ts,.vue,.js --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.vue,.js --fix",
    "typecheck": "vue-tsc --noEmit"
  },
  "keywords": [
    "electron",
    "vue",
    "vite",
    "ai",
    "token",
    "monitor",
    "openai",
    "anthropic"
  ],
  "author": {
    "name": "VibeUsage",
    "email": "support@vibeusage.app"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/code-yeongyu/VibeUsage/issues"
  },
  "homepage": "https://github.com/code-yeongyu/VibeUsage",
  "devDependencies": {
    "@electron-forge/cli": "^7.4.0",
    "@electron-forge/maker-deb": "^7.4.0",
    "@electron-forge/maker-dmg": "^7.4.0",
    "@electron-forge/maker-squirrel": "^7.4.0",
    "@electron-forge/maker-zip": "^7.4.0",
    "@electron-forge/plugin-vite": "^7.4.0",
    "@electron/rebuild": "^4.0.2",
    "@types/node": "^20.11.0",
    "@types/sql.js": "^1.4.9",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "electron": "^39.2.6",
    "electron-rebuild": "^3.2.9",
    "electron-vite": "^2.3.0",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.20.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.2.0",
    "vue": "^3.4.0",
    "vue-tsc": "^1.8.0"
  },
  "dependencies": {
    "echarts": "^5.5.0",
    "electron-store": "^8.1.0",
    "element-plus": "^2.5.0",
    "keytar": "^7.9.0",
    "pinia": "^2.1.0",
    "sql.js": "^1.13.0",
    "vue-echarts": "^6.6.0"
  }
}
